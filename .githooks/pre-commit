#!/usr/bin/env bash
# Pre-commit hook: block accidental WASM file commits
#
# WASM builds are non-reproducible. Committing rebuilt WASMs without a
# migration entry breaks delegate key continuity and causes data loss.
# See .claude/rules/wasm-safety.md for details.

set -euo pipefail

# Check if any WASM files in contracts directories are staged
WASM_FILES=$(git diff --cached --name-only -- \
    'ui/public/contracts/*.wasm' \
    'cli/contracts/*.wasm' \
    2>/dev/null || true)

if [ -z "$WASM_FILES" ]; then
    exit 0
fi

# Allow if legacy_delegates.toml is also staged (single source of truth for delegate migration)
REGISTRY_STAGED=$(git diff --cached --name-only -- \
    'legacy_delegates.toml' \
    2>/dev/null || true)

if [ -n "$REGISTRY_STAGED" ]; then
    echo "WASM files staged with legacy_delegates.toml — allowing commit."
    exit 0
fi

echo ""
echo "BLOCKED: WASM files are staged for commit WITHOUT legacy_delegates.toml!"
echo ""
echo "Staged WASM files:"
echo "$WASM_FILES" | sed 's/^/  /'
echo ""
echo "Committing rebuilt delegate WASMs without updating legacy_delegates.toml"
echo "breaks delegate key continuity and can cause users to lose board data."
echo ""
echo "If this is intentional:"
echo "  1. Run: cargo run --manifest-path tools/wasm-tool/Cargo.toml -- add <desc>"
echo "  2. Stage legacy_delegates.toml alongside the WASMs"
echo ""
echo "If this is accidental:"
echo "  git restore --staged ui/public/contracts/ cli/contracts/"
echo "  git checkout HEAD -- ui/public/contracts/ cli/contracts/"
echo ""
exit 1
